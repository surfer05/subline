{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,

    // TYPE CHECK ONLY (`tsc -p .` from the repo root). esbuild ignores these,
    // so none of them changes the build:
    //  - "jsx": "preserve" is what Vencord's own tsconfig says. The build's
    //    jsx: "transform" wins over a tsconfig "preserve", but a tsconfig
    //    jsxFactory WOULD override Vencord's VencordCreateElement (measured
    //    with esbuild 0.28.1), so no factory is named here.
    //  - The plugin runs inside Vencord, so it is checked against Vencord's
    //    ambient types: its globals (VencordNative, IS_DEV...), its "electron"
    //    module, and @types/node and @types/react from the sibling checkout.
    "jsx": "preserve",
    "typeRoots": ["../Vencord/node_modules/@types"],

    // src/userplugins/vcTranslate is symlinked into the Vencord checkout
    // (a sibling directory) for building. esbuild's tsconfig auto-discovery
    // walks up from a file's REAL (symlink-resolved) path, so files under
    // this plugin resolve to THIS tsconfig, not Vencord's — and would
    // otherwise fail to resolve Vencord's "@api/*", "@utils/*", etc. bare
    // specifiers. Mirroring Vencord's own path map (relative to the sibling
    // checkout) lets esbuild's default per-file discovery find the real
    // files. Vencord's own internal files are unaffected: they still resolve
    // via their own tsconfig.json through normal walk-up discovery.
    "paths": {
      "@main/*": ["../Vencord/src/main/*"],
      "@api/*": ["../Vencord/src/api/*"],
      "@components/*": ["../Vencord/src/components/*"],
      "@debug/*": ["../Vencord/src/debug/*"],
      "@utils/*": ["../Vencord/src/utils/*"],
      "@plugins/*": ["../Vencord/src/plugins/*"],
      "@shared/*": ["../Vencord/src/shared/*"],
      "@webpack/common": ["../Vencord/src/webpack/common"],
      "@webpack/common/*": ["../Vencord/src/webpack/common/*"],
      "@webpack": ["../Vencord/src/webpack/webpack"],
      "@webpack/patcher": ["../Vencord/src/webpack/patchWebpack"],
      "@webpack/wreq.d": ["../Vencord/src/webpack/wreq.d"],
      "@webpack/types": ["../Vencord/src/webpack/types"],
      // Imported with `import type` only, so esbuild never resolves it.
      "@vencord/discord-types": ["../Vencord/node_modules/@vencord/discord-types"]
    }
  },
  // Only the plugin. Without this, tsc swept every .ts under the repo root:
  // the relay and the installer (each has its own tsconfig) and the pinned
  // Vencord copy in installer/build, none of which this config describes.
  // Vencord's ambient declarations are listed so its globals resolve.
  "include": [
    "src/**/*",
    "../Vencord/src/globals.d.ts",
    "../Vencord/src/modules.d.ts",
    "../Vencord/src/nativeModules.d.ts"
  ]
}
