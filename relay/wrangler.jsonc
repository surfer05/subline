{
  // Subline translation relay — Cloudflare Worker.
  // Deploy: see README.md. Secrets (OPENROUTER_KEY, GROQ_KEY, GEMINI_KEY,
  // ADMIN_TOKEN, MOR_WEBHOOK_SECRET) are set with `wrangler secret put`, NEVER
  // in this file or git.
  //   GEMINI_KEY is a billing-enabled Google Gemini API key. When it is set AND
  //   MODEL is a `gemini*` id, Gemini is the PRIMARY translation provider and
  //   Groq (FALLBACK_MODEL) is the automatic fallback on any Gemini failure
  //   (rate limit / overload / bad key). Drop the key or point MODEL back at a
  //   Groq id to run Groq-only.
  //   MOR_WEBHOOK_SECRET is the Dodo Payments webhook SIGNING SECRET — the
  //   `whsec_...` value from the endpoint's Overview tab in the Dodo dashboard.
  //   Dodo follows the Standard Webhooks spec: the relay HMAC-SHA256s
  //   `${webhook-id}.${webhook-timestamp}.${rawBody}` with the base64-decoded
  //   secret and compares (base64) against the `webhook-signature` header.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subline-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // ROUTING (decided by which SECRETS are set, not by this id alone — see
    // providers() in src/index.ts, which sets an explicit Provider.kind because
    // OpenRouter and Groq serve the SAME model ids):
    //   OPENROUTER_KEY set → OpenRouter is PRIMARY on MODEL, pinned to Groq's
    //     hosting (provider.order groq, cerebras, deepinfra;
    //     require_parameters so structured output is never silently dropped).
    //     This is the pay-as-you-go path: Groq's Developer upgrade is closed, so
    //     the DIRECT Groq key is stuck on the free tier's daily token ceiling.
    //   GROQ_KEY → the automatic FALLBACK, on FALLBACK_MODEL. Free tier, but it
    //     keeps the product answering through an OpenRouter outage or a 402.
    //   GEMINI_KEY + a `gemini*` MODEL → Gemini is primary instead, optional,
    //     with OpenRouter (else Groq) as its fallback.
    // No new var is needed for any of this: adding or dropping the
    // OPENROUTER_KEY secret is the whole switch.
    //
    // Primary model. LAUNCH SETTING: openai/gpt-oss-120b, proven on real chat,
    // and a valid id on BOTH OpenRouter and Groq, so the primary and the
    // fallback run the same model. To move to Gemini later: set this to
    // "gemini-3.8-flash" AND `wrangler secret put GEMINI_KEY` (a billing-enabled
    // key). Without that key, a gemini id here is ignored and the OpenAI-shaped
    // providers use FALLBACK_MODEL instead.
    "MODEL": "openai/gpt-oss-120b",
    // Model for the FALLBACK provider (the direct Groq key), and for any
    // OpenAI-shaped provider that must not be handed a `gemini*` MODEL. Keeps
    // the product answering through a primary rate-limit/outage.
    "FALLBACK_MODEL": "openai/gpt-oss-120b",
    // Freeze the whole relay after this many cost-units, ever. A unit is ~1
    // message (cost = messages + ceil(promptChars/1000)). On gpt-oss-120b that
    // was ~$0.04-0.07/1k; Gemini 3.8 Flash is ~2-3x that per unit, so 400,000
    // units is now a ~$30-60 launch wall depending on output length. Raise it
    // deliberately after watching real spend vs the cost-units in metrics.
    "GLOBAL_BUDGET_MESSAGES": "400000",
    // Dodo Payments product_id → { plan, dailyCap }. The webhook maps each paid
    // license key to a plan + fair-use cap by its data.product_id. These are the
    // LIVE Dodo product ids as of 2026-09-21: the two products actually on sale,
    // monthly and annual. Lifetime was dropped, and the old TEST-mode ids are no
    // longer mapped, so a test-mode purchase now fails safe to the free cap
    // rather than minting a paid code. An UNMAPPED or misconfigured product
    // fails SAFE: the code is minted at the free default cap (500/day) and
    // flagged in its note — never at an unbounded cap. A `monthly`/`annual` plan
    // is treated as a SUBSCRIPTION (gets a finite provisional expiry + renews via
    // subscription.* events); `lifetime` is a one-time purchase (never expires).
    // plan ∈ free|paid|monthly|annual|lifetime.
    "VARIANTS": {
      "pdt_0No1xmbcAqHdYAvt1RNPR": { "plan": "monthly", "dailyCap": 2000 },
      "pdt_0No1yAve1ozdxryVGZvf6": { "plan": "annual", "dailyCap": 2000 }
    }
  },
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "Budget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  "kv_namespaces": [
    // Create with `wrangler kv namespace create CODES`, paste the id here.
    { "binding": "CODES", "id": "f83c4973ea574abd9000ad5735ccd52a" }
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "subline_relay" }
  ],
  "env": {
    "staging": {
      "name": "subline-relay-staging",
      "vars": { "MODEL": "openai/gpt-oss-120b", "GLOBAL_BUDGET_MESSAGES": "5000" },
      "kv_namespaces": [{ "binding": "CODES", "id": "REPLACE_WITH_STAGING_KV_ID" }],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "subline_relay_staging" }]
    }
  }
}
