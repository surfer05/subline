{
  // Subline translation relay — Cloudflare Worker.
  // Deploy: see README.md. Secrets (OPENROUTER_KEY, GROQ_KEY, GEMINI_KEY,
  // ADMIN_TOKEN, MOR_WEBHOOK_SECRET) are set with `wrangler secret put`, NEVER
  // in this file or git.
  //   GEMINI_KEY is a billing-enabled Google Gemini API key. When it is set AND
  //   MODEL is a `gemini*` id, Gemini is the PRIMARY translation provider and
  //   Groq (FALLBACK_MODEL) is the automatic fallback on any Gemini failure
  //   (rate limit / overload / bad key). Drop the key or point MODEL back at a
  //   Groq id to run Groq-only.
  //   MOR_WEBHOOK_SECRET is the Dodo Payments webhook SIGNING SECRET — the
  //   `whsec_...` value from the endpoint's Overview tab in the Dodo dashboard.
  //   Dodo follows the Standard Webhooks spec: the relay HMAC-SHA256s
  //   `${webhook-id}.${webhook-timestamp}.${rawBody}` with the base64-decoded
  //   secret and compares (base64) against the `webhook-signature` header.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subline-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // ROUTING (decided by which SECRETS are set, not by this id alone — see
    // providers() in src/index.ts, which sets an explicit Provider.kind because
    // OpenRouter and Groq serve the SAME model ids):
    //   OPENROUTER_KEY set → OpenRouter is PRIMARY on MODEL, pinned to Groq's
    //     hosting (provider.order groq, cerebras, deepinfra;
    //     require_parameters so structured output is never silently dropped).
    //     This is the pay-as-you-go path: Groq's Developer upgrade is closed, so
    //     the DIRECT Groq key is stuck on the free tier's daily token ceiling.
    //   GROQ_KEY → the automatic FALLBACK, on FALLBACK_MODEL. Free tier, but it
    //     keeps the product answering through an OpenRouter outage or a 402.
    //   GEMINI_KEY + a `gemini*` MODEL → Gemini is primary instead, optional,
    //     with OpenRouter (else Groq) as its fallback.
    // No new var is needed for any of this: adding or dropping the
    // OPENROUTER_KEY secret is the whole switch.
    //
    // Primary model. LAUNCH SETTING: openai/gpt-oss-120b, proven on real chat,
    // and a valid id on BOTH OpenRouter and Groq, so the primary and the
    // fallback run the same model. To move to Gemini later: set this to
    // "gemini-3.8-flash" AND `wrangler secret put GEMINI_KEY` (a billing-enabled
    // key). Without that key, a gemini id here is ignored and the OpenAI-shaped
    // providers use FALLBACK_MODEL instead.
    "MODEL": "openai/gpt-oss-120b",
    // Model for the FALLBACK provider (the direct Groq key), and for any
    // OpenAI-shaped provider that must not be handed a `gemini*` MODEL. Keeps
    // the product answering through a primary rate-limit/outage.
    "FALLBACK_MODEL": "openai/gpt-oss-120b",
    // Freeze the whole relay after this many cost-units, ever. A unit is ~1
    // message (cost = messages + ceil(promptChars/1000)). On gpt-oss-120b that
    // was ~$0.04-0.07/1k; Gemini 3.8 Flash is ~2-3x that per unit, so 400,000
    // units is now a ~$30-60 launch wall depending on output length. Raise it
    // deliberately after watching real spend vs the cost-units in metrics.
    // The freeze is derived from this number on every request, so raising it
    // unfreezes at once. GET /admin/budget (and /admin/stats) show the total;
    // POST /admin/budget/reset starts a fresh window with no deploy. Free
    // traffic (previews) stops at 90% of it, so paying AI users keep the rest.
    "GLOBAL_BUDGET_MESSAGES": "400000",
    // AI_MONTHLY_CAP (optional, unset = off): a monthly allowance per AI
    // subscription code, in the same spend units, counted per UTC month. A
    // pricing call for the owner: at ~$0.07 per 1k units, 20000 keeps a maxed
    // subscriber near $1.40 a month against $1.67 net. If you set it, change
    // the site's "Up to 2,000 ✦ a day" copy to match before deploying.
    // Dodo Payments product_id → { plan, dailyCap }. The webhook maps each paid
    // license key to a plan + fair-use cap by its data.product_id. These are the
    // LIVE Dodo product ids as of 2026-09-21: the two products actually on sale,
    // monthly and annual. Lifetime was dropped, and the old TEST-mode ids are no
    // longer mapped, so a test-mode purchase now fails safe to the free cap
    // rather than minting a paid code. An UNMAPPED or misconfigured product
    // fails SAFE: the code is minted at the free default cap (500/day) and
    // flagged in its note — never at an unbounded cap. A `monthly`/`annual` plan
    // is treated as a SUBSCRIPTION (gets a finite provisional expiry + renews via
    // subscription.* events); `lifetime` is a one-time purchase (never expires).
    // plan ∈ free|paid|monthly|annual|lifetime.
    "VARIANTS": {
      "pdt_0No1xmbcAqHdYAvt1RNPR": { "plan": "monthly", "dailyCap": 2000 },
      "pdt_0No1yAve1ozdxryVGZvf6": { "plan": "annual", "dailyCap": 2000 },
      // AUTOMATIC ($4.99 once, license key, never expires), the live Dodo
      // product created 2026-09-29. A test (test/placeholder.test.ts) fails if
      // the old placeholder id ever comes back. dailyCap is not used
      // for spend (Automatic is Google on the client); its ✦ previews are
      // counted per account (5 a day, src/entitle.ts).
      "pdt_0NofMhZ4QRA71V9lJw6K7": { "plan": "automatic", "dailyCap": 5 }
    },
    // Dodo Payments API base for POST /v1/checkout and POST /admin/coupon
    // (src/checkout.ts). Live: https://live.dodopayments.com, test:
    // https://test.dodopayments.com. It must match the mode of the DODO_API_KEY
    // secret (`wrangler secret put DODO_API_KEY`); without that secret both
    // endpoints answer 503 and nothing else changes. VARIANTS above must hold
    // product ids from the same mode.
    "DODO_API_BASE": "https://live.dodopayments.com",
    // Where Dodo sends the buyer after paying. Dodo appends payment_id or
    // subscription_id, status, license_key and email as query parameters, and
    // the site shows its thanks view when it sees them.
    "CHECKOUT_RETURN_URL": "https://subline.page/",
    // Launch of the paid-only model (v2 clients), epoch ms or an ISO date. Set to
    // the moment the fixed early-user cutoff went live, so the legacy path stops
    // starting trials from now on. The release step may move it to the publish
    // moment; that is no longer needed for safety. Early users do NOT depend on
    // it: they are judged against the fixed EARLY_CUTOFF_MS (2026-09-29T00:00Z)
    // in src/entitle.ts. While it is "SET_AT_RELEASE" (or empty) these are OFF:
    //   • grandfathering by date: an AI code created before this moment gives
    //     its account Automatic for good (codes with no createdAt are pre-v2 and
    //     always count);
    //   • the legacy cut-off: after this moment an older (0.1.x) client with an
    //     id the relay never trialled gets the taste allowance, not a new trial.
    "LAUNCH_AT": "2026-09-29T11:56:40Z",
    // PATCH HEALTH (src/patchHealth.ts, POST /v1/patch-health). When at least
    // this many distinct installs report the same Subline patch failing on one
    // UTC day, ONE email per patch per day goes to PATCH_ALERT_TO through the
    // ALERT_EMAIL binding below. Raise it if a single noisy install ever pages
    // you; lower it to 1 to test the email path.
    "PATCH_ALERT_MIN_INSTALLS": "3",
    // Sender must be an address on a zone with Email Routing on (subline.page).
    // The recipient must be a VERIFIED Email Routing destination address.
    "PATCH_ALERT_FROM": "alerts@subline.page",
    "PATCH_ALERT_TO": "rahul05alok@gmail.com"
    // ENTITLEMENT_SECRET (optional secret, `wrangler secret put
    // ENTITLEMENT_SECRET`) signs the v2 entitlement token. It protects nothing
    // on the client (the client cannot verify it; Automatic runs client-side);
    // it only lets this relay recognise its own tokens. AI and previews are
    // decided here on every request, with or without it.
  },
  // PROMO: one Durable Object per promo code, the exact claim counter behind
  // "the first 100 installs" (src/promo.ts). Migration v2 creates the class.
  // The same class also holds the per-install checkout lock (cko:<hash>:<kind>)
  // and the per-address purchase-status rate counter (ps:<addr>:<minute>):
  // new object NAMES only, no new class, so no new migration.
  "durable_objects": { "bindings": [
    { "name": "BUDGET", "class_name": "Budget" },
    { "name": "PROMO", "class_name": "Promo" },
    // PATCH HEALTH: one object per UTC day (ph:<YYYY-MM-DD>), distinct-install
    // counts per patch, deleted after 8 days. Migration v3 creates the class.
    { "name": "PATCH_HEALTH", "class_name": "PatchHealth" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Budget"] },
    { "tag": "v2", "new_sqlite_classes": ["Promo"] },
    { "tag": "v3", "new_sqlite_classes": ["PatchHealth"] }
  ],
  // The owner's patch alert (src/patchHealth.ts). Cloudflare "Send emails from
  // Workers": needs Email Routing ON for subline.page and the destination below
  // VERIFIED under Email Routing > Destination addresses. destination_address
  // locks this binding to that one inbox; nothing else can be emailed.
  "send_email": [
    { "name": "ALERT_EMAIL", "destination_address": "rahul05alok@gmail.com" }
  ],
  "kv_namespaces": [
    // Create with `wrangler kv namespace create CODES`, paste the id here.
    { "binding": "CODES", "id": "f83c4973ea574abd9000ad5735ccd52a" }
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "subline_relay" }
  ],
  "env": {
    "staging": {
      "name": "subline-relay-staging",
      "vars": { "MODEL": "openai/gpt-oss-120b", "GLOBAL_BUDGET_MESSAGES": "5000" },
      "kv_namespaces": [{ "binding": "CODES", "id": "REPLACE_WITH_STAGING_KV_ID" }],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "subline_relay_staging" }]
    }
  }
}
